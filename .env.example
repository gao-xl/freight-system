# ===========================================================================
# 货运代理管理系统 - 环境变量示例
# 用法：cp .env.example .env  然后按需修改
# 生产部署前务必设置所有标注 [必填] 的项，并使用高强度随机值
# ===========================================================================

# ---- 运行环境 ----
# development / production / test
# 生产环境未设置 JWT_SECRET 将拒绝启动
NODE_ENV=development
PORT=3000

# ---- JWT 密钥 [生产必填] ----
# 生产环境必须设置：高强度随机串，建议 >= 64 字符
# 生成方式：openssl rand -hex 48   或   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 开发环境留空将自动生成一次性随机密钥（仅本次进程有效）
JWT_SECRET=

# ---- 数据库 ----
# 方言：sqlite（默认，零运维）| postgres（多并发团队可选）
DB_DIALECT=sqlite
# SQLite 文件路径（仅 sqlite 方言使用）
DB_STORAGE=./data/freight.db
# PostgreSQL 连接（仅 postgres 方言使用）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=freight
DB_USER=freight
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# ---- CORS 跨域白名单 [生产必填] ----
# 逗号分隔多个来源；生产环境应填写前端实际域名
# 示例：https://ffs.example.com,https://www.ffs.example.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ---- 速率限制 ----
# 限流窗口（毫秒），默认 15 分钟
RATE_LIMIT_WINDOW_MS=900000
# 全局每窗口最大请求数
RATE_LIMIT_MAX=300
# 登录接口每窗口最大请求数（防爆破）
RATE_LIMIT_LOGIN_MAX=20

# ---- 外部系统对接（可选）----
# 默认指向本地示例地址，接入真实系统时替换为对应网关地址
PORT_SVC_URL=http://localhost:4001
CUSTOMS_SVC_URL=http://localhost:4002
FINANCE_SVC_URL=http://localhost:4003
