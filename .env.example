# ===========================================================================
# 货运代理管理系统 - 环境变量示例
# 用法：cp .env.example .env  然后按需修改
# 生产部署前务必设置所有标注 [必填] 的项，并使用高强度随机值
# ===========================================================================

# ---- 运行环境 ----
# development / production / test
# 生产环境未设置 JWT_SECRET 将拒绝启动
NODE_ENV=development
PORT=3000

# ---- JWT 密钥 [生产必填] ----
# 生产环境必须设置：高强度随机串，建议 >= 64 字符
# 生成方式：openssl rand -hex 48   或   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 开发环境留空将自动生成一次性随机密钥（仅本次进程有效）
JWT_SECRET=
# access token 有效期（默认 12h）；refresh token 有效期（默认 30d）
#JWT_EXPIRES_IN=12h
#JWT_REFRESH_EXPIRES_IN=30d

# ---- 数据库（仅支持 PostgreSQL）----
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=freight
DB_USER=freight
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=10

# ---- CORS 跨域白名单 [生产必填] ----
# 逗号分隔多个来源；生产环境应填写前端实际域名
# 示例：https://ffs.example.com,https://www.ffs.example.com
# Docker 部署时前端经 nginx 同源代理访问后端，本项通常无需改动；
# 若要从别的域名直连 3000 端口，把该域名加进来。
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ---- 速率限制 ----
# 限流窗口（毫秒），默认 15 分钟
RATE_LIMIT_WINDOW_MS=900000
# 全局每窗口最大请求数
RATE_LIMIT_MAX=300
# 登录接口每窗口最大请求数（防爆破）
RATE_LIMIT_LOGIN_MAX=20

# ---- 外部系统对接（可选）----
# 默认指向本地示例地址，接入真实系统时替换为对应网关地址
PORT_SVC_URL=http://localhost:4001
CUSTOMS_SVC_URL=http://localhost:4002
FINANCE_SVC_URL=http://localhost:4003

# ---- 备份 ----
# 备份归档输出目录，默认 backend/backups
# BACKUP_DIR=./backups
# 保留最近几份，超出自动删除
BACKUP_KEEP=7
# 填了才启用常驻定时备份（node scripts/backup.js 会守着这个表达式跑）
# 交给宿主机 crontab 更省资源，二选一即可
# BACKUP_CRON=0 2 * * *
# 默认备份含 PostgreSQL 业务库（pg_dump，需 pg 客户端，Docker 镜像已内置）。
# 设 BACKUP_NO_PG=1 显式跳过数据库（仅特殊场景，业务数据不备份）。
# BACKUP_NO_PG=0

# ---- Docker 部署（仅 docker compose 读取，本地直跑无影响）----
# 宿主机映射端口：前端入口 / 后端直连
FRONTEND_PORT=8080
BACKEND_PORT=3000
# 容器时区
TZ=Asia/Shanghai
# PostgreSQL 服务名 pg，DB_HOST 必须填服务名 pg
# DB_PASSWORD 留空会用默认值 freight，生产环境务必改掉
# PG_PORT=5432

# ---- 多架构镜像构建（仅 build.sh / build.ps1 读取）----
# 目标架构列表，逗号分隔；默认 amd64+arm64
# PLATFORMS=linux/amd64,linux/arm64
# 镜像标签，默认 latest
# IMAGE_TAG=latest
# 镜像仓库前缀（含结尾 /），设置后才能 --push
# IMAGE_REGISTRY=registry.example.com/
