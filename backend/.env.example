# ===== 货运代理管理系统 后端环境变量示例 =====
# 复制本文件为 .env 并按需修改。生产环境必须逐项配置。

# 运行环境：development / production
NODE_ENV=development

# 服务端口
PORT=3000

# ===== 安全（生产环境必填）=====
# JWT 签名密钥：生产必须设置为高强度随机串，例如
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 生产未设置将拒绝启动。
JWT_SECRET=
# access token 有效期（默认 12h）
#JWT_EXPIRES_IN=12h
# refresh token 有效期（默认 30d），到期后需重新登录
#JWT_REFRESH_EXPIRES_IN=30d

# CORS 白名单（逗号分隔），生产必填
# CORS_ORIGIN=https://your-domain.com

# ===== 数据库（仅支持 PostgreSQL）=====
DB_DIALECT=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=freight
DB_USER=freight
# 生产必填：高强度数据库密码。docker compose 启动时若缺失会直接报错拒绝启动（不再使用弱默认值），
# 建议用与 JWT_SECRET 同等级的高强度随机串。
DB_PASSWORD=
DB_SSL=false

# ===== 限流 =====
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# RATE_LIMIT_LOGIN_MAX=20

# ===== 外部系统对接 =====
# PORT_SVC_URL=http://localhost:4001
# CUSTOMS_SVC_URL=http://localhost:4002
# FINANCE_SVC_URL=http://localhost:4003

# ===== 第三方 AI（OpenAI 兼容协议，可选）=====
# 首选在系统「外部对接」页配置 ai_chat（baseUrl/apiKey/config.model）。
# 以下环境变量作为未配置时的兜底默认值（优先用表配置）。
# AI_BASE_URL=https://openrouter.ai/api/v1   # 可指向 OpenRouter/OpenAI/通义/DeepSeek 等
# AI_API_KEY=                                # 服务商 API Key
# AI_MODEL=openai/gpt-4o-mini                # 默认模型（OpenRouter 免费模型如 deepseek/...:free）

# ===== E1 外部跟踪自动拉取（默认开启）=====
# 定时调用船期/AIS/场站适配器 → 自动写入运输跟踪(auto) → 触发 ETA/船期预警。
# 适配器需在系统「外部对接」中启用并配置密钥，未配置的适配器自动跳过（不影响其他拉取与主流程）。
# TRACK_AUTO_PULL=off           # 总开关（默认开；设为 off 关闭全部拉取）
# TRACK_AUTO_PULL_SCHEDULE=off  # 关闭船期同步（默认开，每 6h）
# TRACK_AUTO_PULL_AIS=off       # 关闭 AIS 船位（默认开，每 2h）
# TRACK_AUTO_PULL_YARD=off      # 关闭场站状态（默认开，每 4h）

# ===== E2 通知推送（预警/事件出站通知；默认零副作用，缺配置渠道自动跳过）=====
# 邮件渠道（nodemailer + SMTP）。配置 SMTP_HOST 即启用，发送对象取 NOTIFY_EMAIL_TO。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465                 # 465 走 SSL；587 走 STARTTLS（secure 自动按端口判断）
# SMTP_USER=notify@example.com
# SMTP_PASS=
# SMTP_FROM=货代系统 <notify@example.com>   # 可选，默认取 SMTP_USER
# NOTIFY_EMAIL_TO=ops@example.com,manager@example.com   # 收件人（逗号分隔）
# NOTIFY_EMAIL=off              # 关闭邮件渠道（默认开，前提是 SMTP_HOST 已配置）
#
# 企微群机器人 Webhook。配置 WECHAT_WEBHOOK 即启用；也可用既有 notification 插件
# 的 PUT /api/plugins/notification/config 写入 IntegrationConfig（code=wechat_webhook）作为回退。
# WECHAT_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# NOTIFY_WECHAT=off             # 关闭企微渠道（默认开，前提是 Webhook 已配置）

# ===== S4 二次认证(2FA) =====
# SMTP 可在「系统设置 → SMTP 配置」页录入（存库，优先于上方 SMTP_* 环境变量），企业邮箱建议走该页面。
# 下方为 2FA 时效/限频参数（均可选，默认值见下）：
# TWO_FACTOR_PENDING_TTL=5m        # 登录 2FA 暂态 token 有效期
# TWO_FACTOR_REAUTH_TTL=3m         # 敏感操作复核 token 有效期
# TWO_FACTOR_CODE_TTL_MS=300000    # 邮箱验证码有效期(毫秒)
# TWO_FACTOR_RESEND_WINDOW_MS=60000# 邮箱验证码重发最小间隔(毫秒)
# TWO_FACTOR_MAX_ATTEMPTS=5        # 单次暂态期最多校验次数
#
# 通用 Webhook（任意支持 POST JSON 的系统）。配置 WEBHOOK_URL 即启用。
# WEBHOOK_URL=https://example.com/hooks/freight
# NOTIFY_WEBHOOK=off            # 关闭通用渠道（默认开，前提是 URL 已配置）
#
# 可选订阅的关键业务事件（逗号分隔）；默认仅推送预警（alert.created/alert.resolved）。
# NOTIFY_BUSINESS_EVENTS=order.created,order.transitioned

# ===== 备份守护（强制月度自动备份 + 超期提醒/补备）=====
# 系统内置备份守护，默认强制开启（fail-closed）：每月自动备份一次，并每日检查距上次备份的天数，
# 超过阈值会推送「备份超期」提醒（站内消息 + email/企微/webhook，渠道缺配置自动跳过）。
# 这是为低成本设备（开发板 / 小主机 / NAS 上 Docker 部署）默认开启的数据安全保障。
# BACKUP_AUTO=off            # 整体关闭自动备份（仅特殊场景，如外部 cron 已接管；默认强制开启）
# BACKUP_CRON=30 3 1 * *     # 月度自动备份 cron（默认每月 1 号 03:30）
# BACKUP_FRESHNESS_CRON=0 9 * * *   # 每日超期检查 cron（默认每日 09:00）
# BACKUP_MAX_AGE_DAYS=35     # 超期阈值（天）：距上次备份超过该值则提醒并（强制时）补备
# BACKUP_KEEP=7              # 保留最近份数（默认 7）
# BACKUP_DIR=/mnt/nas/freight-backups   # 备份输出目录（默认 backend/backups；NAS 场景建议指到挂载盘）