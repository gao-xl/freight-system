# ===== 货运代理管理系统 后端环境变量示例 =====
# 复制本文件为 .env 并按需修改。生产环境必须逐项配置。

# 运行环境：development / production
NODE_ENV=development

# 服务端口
PORT=3000

# ===== 安全（生产环境必填）=====
# JWT 签名密钥：生产必须设置为高强度随机串，例如
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# 生产未设置将拒绝启动。
JWT_SECRET=

# CORS 白名单（逗号分隔），生产必填
# CORS_ORIGIN=https://your-domain.com

# ===== 数据库 =====
# 生产推荐 PostgreSQL；本地开发可用 sqlite
DB_DIALECT=sqlite
# PostgreSQL 专用：
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=freight
DB_USER=freight
DB_PASSWORD=
DB_SSL=false
# SQLite 专用：
DB_STORAGE=./data/freight.db

# ===== 限流 =====
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300
# RATE_LIMIT_LOGIN_MAX=20

# ===== 外部系统对接 =====
# PORT_SVC_URL=http://localhost:4001
# CUSTOMS_SVC_URL=http://localhost:4002
# FINANCE_SVC_URL=http://localhost:4003