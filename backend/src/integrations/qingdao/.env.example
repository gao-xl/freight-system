# ============================================
# 青岛港集成模块 - 环境变量配置
# 复制此文件为 .env 并填写实际值
# ============================================

# ---- 云港通平台 ----
# 青岛港云港通企业账号
YGT_USERNAME=your_username
YGT_PASSWORD=your_password
# YGT_BASE_URL=https://www.qingdao-port.net
# YGT_LOGIN_URL=https://www.qingdao-port.net/page/login.html

# ---- 陆海通平台 ----
# 山东港口陆海通企业账号
LHT_USERNAME=your_username
LHT_PASSWORD=your_password
# LHT_BASE_URL=https://www.sdland-sea.com
# LHT_LOGIN_URL=https://www.sdland-sea.com/login

# ---- 浏览器配置 ----
# BROWSER_POOL_SIZE=2          # 浏览器实例数
# BROWSER_HEADLESS=true        # 无头模式（生产环境建议 true）

# ---- 船讯网 API ----
# 申请地址: https://www.shipxy.com/
# 免费版可获取岸基AIS数据
SHIPXY_API_KEY=your_api_key_here

# ---- Redis 缓存 (可选) ----
# REDIS_ENABLED=true
# 使用项目已有的 Redis 连接配置

# ---- 调度器 (cron 表达式) ----
# SCHEDULE_CUSTOMS=*/30 * * * *     # 通关状态：每30分钟
# SCHEDULE_CONTAINER=*/30 * * * *   # 集装箱：每30分钟
# SCHEDULE_VESSEL=0 */2 * * *       # 船舶动态：每2小时

# ---- 通知 ----
# QD_NOTIFY_ENABLED=true
# QD_LOG_LEVEL=info