{
  "name": "freight-forwarding-backend",
  "version": "1.0.0",
  "description": "货运代理管理系统 - 后端服务",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "init-db": "node src/init-db.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "test": "node --test --test-concurrency=1 tests/smoke.test.js tests/pdf.test.js tests/onboarding.test.js tests/tracking-auto.test.js",
    "test:backup": "node --test --test-concurrency=1 tests/backup.test.js"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11",
    "pg": "^8.22.0",
    "proxy-agent": "^6.5.0",
    "puppeteer-core": "^22.15.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1",
    "winston": "^3.19.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5"
  }
}
