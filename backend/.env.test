# 测试环境变量（npm test 使用）— 连接本地 PostgreSQL 测试库 freight_test
# 测试文件读取 TEST_DB_* 变量，故此处提供 TEST_DB_* 前缀
NODE_ENV=test
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=freight_test
TEST_DB_USER=freight
TEST_DB_PASSWORD=12345678
JWT_SECRET=test-jwt-secret-do-not-use-in-production
# 仅集成测试使用：种子账号需覆盖受保护业务接口，生产/开发种子默认仍强制首登改密。
TEST_SEED_MUST_CHANGE_PASSWORD=false
